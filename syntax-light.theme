{
    "text-color": "#1a1a1a",
    "background-color": "#ffffff",
    "line-number-color": "#999999",
    "line-number-background-color": "#ffffff",
    "text-styles": {
        "Other": {
            "text-color": "#1a1a1a"
        },
        "Attribute": {
